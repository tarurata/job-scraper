{
    "manifest_version": 3,
    "name": "Job Info Collector",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "storage",
        "identity"
    ],
    "host_permissions": [
        "https://*.indeed.com/*",
        "https://*.linkedin.com/*",
        "https://sheets.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "__CLIENT_ID__",
        "scopes": [
            "https://www.googleapis.com/auth/spreadsheets"
        ]
    },
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.indeed.com/*",
                "https://*.linkedin.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}